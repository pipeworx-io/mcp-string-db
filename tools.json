[
  {
    "name": "resolve",
    "description": "Map free-text identifiers (gene symbols, accessions) → STRING identifiers.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "identifiers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "species": {
          "type": "number",
          "description": "NCBI taxonomy id (default 9606)."
        },
        "limit": {
          "type": "number",
          "description": "Best-N matches per input (default 1)."
        }
      },
      "required": [
        "identifiers"
      ]
    }
  },
  {
