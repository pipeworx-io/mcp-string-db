        "identifiers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "species": {
          "type": "number"
        },
        "required_score": {
          "type": "number",
          "description": "0-1000 confidence score (default 400)."
        },
        "limit": {
          "type": "number",
          "description": "Max partners per protein (default 10)."
        },
        "network_type": {
          "type": "string",
          "description": "functional (default) | physical"
        }
      },
      "required": [
        "identifiers"
      ]
    }
  },
